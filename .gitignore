# Entorno y cache
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Datos: se regeneran ejecutando la cadena de src/
datos/crudo/
datos/procesado/
datos/powerbi/

# Modelo entrenado: 27 MB, se regenera con el cuaderno 07
modelos/*.txt

# Se versionan los agregados y los JSON de resultados, que son ligeros
!datos/agregados/
!datos/metadatos_extraccion.json
!modelos/*.json

# Salidas locales y carpetas de trabajo
documentos/*
_limpio/

# Entregables: se versionan de forma explicita
!documentos/Memoria_TFM_Eduardo_Flores_Carralero.docx
!documentos/cuadro_mando_co2.pbix
!documentos/cuadro_mando.pdf

# Temporales de Office y del sistema
~$*
.DS_Store
Thumbs.db
